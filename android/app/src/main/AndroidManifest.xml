<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 12 replaced the blanket BLUETOOTH permission with SCAN and
      CONNECT, and made both runtime grants.

      usesPermissionFlags="neverForLocation" is the important one: without it
      Android treats a BLE scan as a way to derive the user's location and
      demands ACCESS_FINE_LOCATION on top. This app only ever looks at the
      advertised device name, so it declares that it will not use scan results
      for location and never has to ask for it.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 and below, where the dedicated permissions do not exist. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
      The Headsets tab: finding HexR headsets on the local Wi-Fi and talking to them over it.

      INTERNET is Android's name for opening any socket, including one that never leaves the
      room: the app talks only to headsets on the same Wi-Fi, and nothing it sends goes further.
      ACCESS_NETWORK_STATE lets it pin those sockets to the Wi-Fi network, so a router with no
      internet behind it does not send them out over mobile data instead.
      CHANGE_WIFI_MULTICAST_STATE is for the multicast lock: without one, the Wi-Fi driver drops
      the broadcast packets headsets announce themselves with, to save power. It is held only
      while the Headsets tab is open.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Required, not optional: without BLE this app does nothing at all. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!--
      ACCESS_FINE_LOCATION above implies a *required* android.hardware.location
      feature, which would have Play hide the app from any device without one.
      The app has no use for the hardware - the permission is only there because
      Android 11 and older made it the price of a BLE scan - so say so, or the
      store quietly narrows the device list on our behalf.
    -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      enableOnBackInvokedCallback: the panels on the Test tab and a headset's detail on the
      Headsets tab close on Back through Compose's BackHandler. Targeting API 36, Android 16 no
      longer sends Back the old way, and an OPPO phone left this app off the new way unless it is
      asked for here, so Back sent the whole app to the background instead of closing a panel.
    -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HexrCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HexrCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
